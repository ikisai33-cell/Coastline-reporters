# ==============================================================================
# COASTLINE REPORTERS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit .env.local or real secrets to version control.
# ==============================================================================

# NEXT.JS APPLICATION
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Coastline Reporters"
NEXT_PUBLIC_SITE_TAGLINE="Local News. Global Perspective."

# SUPABASE - PUBLIC CLIENT CONFIGURATION (Safe for browser)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# SUPABASE - SERVER-SIDE SERVICE ROLE KEY (STRICTLY PRIVATE)
# NEVER expose this key in client-side bundles or NEXT_PUBLIC_* variables.
# Used ONLY in privileged server-side operations (e.g. newsroom invitation dispatch, webhooks)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# EDITORIAL & SECURITY SETTINGS
NEWSROOM_INVITE_EXPIRY_HOURS=72
MAX_ARTICLE_ATTACHMENT_MB=25
ALLOWED_MEDIA_MIME_TYPES=image/jpeg,image/png,image/webp,image/avif,application/pdf
